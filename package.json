{
  "name": "omp-agent",
  "version": "0.1.0-g1a.0",
  "description": "Personal OMP plugin for managed tasks, verified execution, and checked delivery",
  "type": "module",
  "private": true,
  "engines": { "bun": ">=1.4.0" },
  "omp": { "extensions": ["./src/daily-entry.ts"] },
  "files": [
    "src",
    "policy",
    "scripts/isolated-exec.py",
    "docs/architecture.md",
    "docs/testing.md",
    "docs/release-notes.md",
    "README.md",
    "vendor/harness2/index.ts",
    "vendor/harness2/SOURCE.json",
    "vendor/harness2/upstream/LICENSE",
    "vendor/harness2/upstream/NOTICE",
    "vendor/harness2/upstream/src/adaptation.ts",
    "vendor/harness2/upstream/src/approval-channel.ts",
    "vendor/harness2/upstream/src/capabilities.ts",
    "vendor/harness2/upstream/src/commands.ts",
    "vendor/harness2/upstream/src/controller.ts",
    "vendor/harness2/upstream/src/conversation.ts",
    "vendor/harness2/upstream/src/diff.ts",
    "vendor/harness2/upstream/src/evolution-completion.ts",
    "vendor/harness2/upstream/src/evolution.ts",
    "vendor/harness2/upstream/src/exploration-prompts.ts",
    "vendor/harness2/upstream/src/exploration.ts",
    "vendor/harness2/upstream/src/generated-extension.ts",
    "vendor/harness2/upstream/src/host-tools.ts",
    "vendor/harness2/upstream/src/method-authoring.ts",
    "vendor/harness2/upstream/src/omp-profile.ts",
    "vendor/harness2/upstream/src/planner-catalog.ts",
    "vendor/harness2/upstream/src/planner-methods.ts",
    "vendor/harness2/upstream/src/prompts.ts",
    "vendor/harness2/upstream/src/runner.ts",
    "vendor/harness2/upstream/src/runtime-policy.ts",
    "vendor/harness2/upstream/src/store.ts",
    "vendor/harness2/upstream/src/surface.ts",
    "vendor/harness2/upstream/src/task-graph.ts",
    "vendor/harness2/upstream/src/types.ts",
    "vendor/harness2/upstream/src/workflows.ts",
    "vendor/harness2/upstream/src/workspace.ts"
  ],
  "scripts": {
    "check": "bun run typecheck && bun test test/unit && bun run test:human-review",
    "test": "bun test test/unit",
    "test:omp": "bun run scripts/test-omp.ts",
    "test:entry": "bun run scripts/test-entry.ts",
    "test:jobs": "bun run scripts/test-jobs.ts",
    "test:delivery": "bun run scripts/test-delivery.ts",
    "test:daily": "bun run scripts/test-daily.ts",
    "test:package-entry": "bun run scripts/test-package-entry.ts",
    "test:human-review": "bun test test/human-review",
    "test:human-review-native": "bun run scripts/test-human-review-native.ts",
    "typecheck": "bun x tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  }
}
